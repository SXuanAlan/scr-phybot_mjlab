<mujoco model="forearm_hand">
  <compiler angle="radian" meshdir="../../phybot_big_v2/meshes/" autolimits="true"/>
  <option timestep="0.002" iterations='10' solver='PGS' ccd_iterations='1000' gravity='0 0 -9.81'>
  </option>
  <size njmax="500" nconmax="100" />
  <default>
      <geom condim='4' solref='0.001 2' friction='1.0 0.5 0.5'/>
      <equality solref='0.001 2'/>
      <default class="forearm">
          <joint damping="1" armature="0.1"/>
          <default class="visual">
              <geom type="mesh" contype="0" conaffinity="0" group="2" />
          </default>
          <default class="collision">
              <geom group="3" mass="0" density="0" friction="1.0 0.1 0.1" />
          </default>
          <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
      </default>
  </default>
  <visual>
      <quality shadowsize='4096'/>
      <map force="0.1" zfar="30" znear='0.05'/>
      <rgba haze="0.15 0.25 0.35 1"/>
      <global offwidth="2560" offheight="1440" elevation="-20" azimuth="120"/>
  </visual>
  <asset>
      <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="32" height="512"/>
      <mesh name="right_elbow_pitch" file="right_elbow_pitch.STL"/>
      <mesh name="right_elbow_yaw" file="right_elbow_yaw.STL"/>
      <mesh name="right_hand" file="right_hand.stl" scale="0.001 0.001 0.001"/>
      <texture builtin="gradient" height="100" rgb1=".4 .5 .6" rgb2="0 0 0" type="skybox" width="100"/>
      <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="100" height="100"/>
      <material name="MatPlane" reflectance="0.5" texture="texplane" texrepeat="1 1" texuniform="true"/>
  </asset>

  <worldbody>
    <geom name="floor" friction="1 .1 .1" pos="0 0 0.0" size="50 50 0.125" type="plane" material="MatPlane" condim="3" conaffinity="1" contype="1" group="2" rgba="0.8 0.9 0.8 1"/>
    <light cutoff="100" diffuse="1 1 1" dir="-0 0 -1.3" directional="true" exponent="1" pos="0 0 1.3" specular=".1 .1 .1" castshadow="false"/>

    <!-- Forearm base: right_elbow_pitch with free joint -->
    <!-- No rotation: chain hangs in -z (forearm vertical, hand pressing against wall in +x) -->
    <body name="right_elbow_pitch" pos="0 0 1.5" quat="1 0 0 0" childclass="forearm">
      <inertial pos="-0.00255364 -0.00288876 -0.00638524" quat="0.971457 0.0955752 0.215551 -0.0259581" mass="0.845839" diaginertia="0.00080846 0.00070795 0.00062105"/>
      <joint name="floating_base_joint" type="free" limited="false" actuatorfrclimited="false"/>

      <geom name="right_elbow_pitch_visual" type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.792157 0.819608 0.933333 1" mesh="right_elbow_pitch"/>
      <geom name="right_elbow_pitch_collision" type="cylinder" rgba="0.792157 0.819608 0.933333 1" pos="0 0 -0.06" quat="1 0 0 0" size="0.035 0.06 0"/>

      <body name="right_elbow_yaw" pos="-0.01 0 -0.123">
        <inertial pos="0 0 0.0343762" mass="0.746923" diaginertia="0.000577754 0.000577754 0.000420109"/>
        <joint name="right_elbow_yaw" pos="0 0 0" axis="0 0 1" range="-1.57 1.57" actuatorfrcrange="-58 58"/>
        <geom name="right_elbow_yaw_visual" type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.792157 0.819608 0.933333 1" mesh="right_elbow_yaw"/>
        <geom name="right_elbow_yaw_collision" type="cylinder" rgba="0.792157 0.819608 0.933333 1" pos="0 0 0.02" quat="1 0 0 0" size="0.03 0.05 0"/>

        <body name="right_hand" pos="0 0 -0.05">
          <inertial pos="0 0 0" mass="0.3" diaginertia="0.0002 0.0002 0.0002"/>
          <geom name="right_hand_visual" type="mesh" mesh="right_hand" contype="0" conaffinity="0" group="1" density="0" rgba="0.9 0.7 0.5 1"/>
          <geom name="right_hand_collision" type="mesh" mesh="right_hand" contype="1" conaffinity="1" rgba="0.9 0.7 0.5 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <keyframe>
    <key name="home"
      qpos="0 0 1.5 1 0 0 0
             0" />
  </keyframe>
</mujoco>
